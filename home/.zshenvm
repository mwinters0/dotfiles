# .zshenv runs for both interactive and non-interactive sessions.

export MW_SSH_CONFIG="$HOME/.ssh/config_noop"
export PATH="$HOME/.local/bin:$PATH"
export EDITOR=/usr/bin/nvim

export fedora='/home/mwinters/projects/fedora'
export fdwg="$fedora/fdwg"

eval `oidc-agent-service use`
eval "$(/home/mwinters/.local/bin/mise/mise activate zsh)"
